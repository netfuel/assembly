# Copy to .dev.vars for local sign-in. Never commit .dev.vars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 key contents on one line with \n for line breaks.
APPLE_PRIVATE_KEY=

# Local testing: "1" adds a test sign-in on localhost (never set this in production).
DEV_LOGIN=
# Promo video (Cloudflare Stream): account ID and an API token with Stream: Edit.
CLOUDFLARE_ACCOUNT_ID=
STREAM_API_TOKEN=
# Optional: Stream customer code for playback URLs (customer-<code>.cloudflarestream.com).
STREAM_CUSTOMER_CODE=
