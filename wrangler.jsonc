{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assembly",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The React app is served as static assets; only /api/* runs the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "http://localhost:5173",
    "DEFAULT_CITY": "memphis"
  },
  // Create these with the commands in README.md, then paste the IDs here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assembly",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "00000000000000000000000000000000" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "assembly-media" }
  ]
  // Secrets (set with `wrangler secret put`, or .dev.vars locally):
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // APPLE_CLIENT_ID, APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY
}
