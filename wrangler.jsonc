{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assembly",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Builds runs only `npx wrangler deploy`, so wrangler builds the app first.
  // (The Vite plugin ignores "build" and "assets.directory" for its own builds; that warning is expected.)
  "build": { "command": "npm run build" },
  // The React app is served as static assets; /api/* and /fonts/* run the Worker.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/fonts/*"]
  },
  "observability": { "enabled": true },
  // Starting-soon push reminders (worker/notify.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "DEFAULT_CITY": "memphis"
  },
  // Real IDs are written here by setup-cloudflare.command (scripts/setup-cloudflare.mjs).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assembly",
      "database_id": "f34d292b-b79e-4dbe-a86d-5b36ebe9f36d",
      "migrations_dir": "db/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "2cf39862b0304d58a13ff7b80beb9ba2" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "assembly-media" }
  ]
  // Secrets (set with `wrangler secret put`, or .dev.vars locally):
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // APPLE_CLIENT_ID, APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY
}
