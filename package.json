{
  "name": "assembly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply assembly --local",
    "db:migrate:remote": "wrangler d1 migrations apply assembly --remote",
    "db:seed:local": "wrangler d1 execute assembly --local --file=./db/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "setup:local": "npm run db:migrate:local && npm run db:seed:local"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "arctic": "^3.7.0",
    "hono": "^4.13.13",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22"
  }
}
