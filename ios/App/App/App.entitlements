<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ties the app to assembly.rsvp (served at /.well-known/apple-app-site-association, worker/passkeys.ts).
	     webcredentials: the site's passkeys work in the app. applinks: event, page and invite links open the app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:assembly.rsvp</string>
		<string>applinks:assembly.rsvp</string>
	</array>
	<!-- Push notifications (worker/apns.ts). Xcode builds use the sandbox; archiving for TestFlight or the App Store
	     switches this to production when the build is signed for distribution. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
